# --- Data (downloaded / derived; never committed — see docs/04_DATASET_SPECIFICATION.md) ---
data/*
!data/.gitkeep

# --- Model artifacts (binary; regenerated by scripts/train.py) ---
# model_metadata.json is intentionally NOT ignored: it records the reported metrics.
models/*.joblib
models/*.pkl
# Per-candidate metadata stays local; reports/metrics_<name>.json is the committed record (ADR-023).
models/*_metadata.json
!models/model_metadata.json

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Virtual environments (incl. throwaway .venv-verify) ---
.venv*/
venv/

# --- Config / secrets ---
.env
!.env.example

# --- Experiment tracking (MLflow not adopted; ignored defensively) ---
mlruns/

# --- Notebooks are not a source of truth ---
.ipynb_checkpoints/

# --- OS / editors ---
.DS_Store
.idea/
.vscode/
