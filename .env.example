# Copy to .env and adjust as needed. All variables are optional; defaults are shown.
# Model constants (WINDOW_SIZE, RUL_CAP, seeds) are not env-driven: they live in
# src/predmaint/config.py and are recorded in model metadata at training time.

# Root data directory; the dataset is stored under $DATA_DIR/raw/CMAPSSData/
DATA_DIR=data
# Directory where scripts/train.py writes candidates and the served model.joblib + model_metadata.json
MODEL_DIR=models
# Served model file loaded by the API (metadata: <stem>_metadata.json beside it).
# Empty = $MODEL_DIR/model.joblib. Pointing it nowhere starts the API in degraded mode (503s).
MODEL_PATH=
# API bind address/port for `python -m predmaint.api.main` (compose uses 0.0.0.0)
API_HOST=127.0.0.1
API_PORT=8000
# Log level for the predmaint loggers and uvicorn
LOG_LEVEL=INFO
# Dashboard -> API base URL (compose sets http://api:8000)
API_BASE_URL=http://localhost:8000
# Dashboard HTTP timeout in seconds
API_TIMEOUT_SECONDS=10
